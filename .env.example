# Copy to .env and fill in. NEVER commit .env. Placeholder values only.

# --- App ---
APP_ENV=development
LOG_LEVEL=INFO
# Bearer token for /api/v1/*. Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_AUTH_TOKEN=change-me
# Local dev without Docker uses SQLite (config/settings.yaml). Docker compose builds a Postgres URL.
# DATABASE_URL=postgresql+psycopg://trader:change-me@localhost:5432/trading

# --- Database (docker-compose.platform.yml) ---
POSTGRES_USER=trader
POSTGRES_PASSWORD=change-me
POSTGRES_DB=trading

# --- SEC EDGAR (free, no key; SEC requires a descriptive User-Agent with contact email) ---
SEC_USER_AGENT="YourCompanyOrName contact@example.com"

# --- Market data / paper broker (Alpaca paper keys: https://app.alpaca.markets) ---
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# --- Optional data providers ---
POLYGON_API_KEY=
FINNHUB_API_KEY=
ALPHA_VANTAGE_API_KEY=
FMP_API_KEY=
TRADIER_API_TOKEN=

# --- Optional crypto broker ---
COINBASE_API_KEY=
COINBASE_API_SECRET=

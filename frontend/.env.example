# Server-side only. Never prefix these with NEXT_PUBLIC_: that would send them to the browser.
# Where the FastAPI backend (backend/) listens.
PLATFORM_API_URL=http://127.0.0.1:8000
# The backend's API_AUTH_TOKEN. Used only by the Next.js server when it forwards requests.
PLATFORM_API_TOKEN=

# Read-only Phantom wallet view (server-side only).
# Solana JSON-RPC endpoint. Empty: balances show as unavailable. Set it only once live access has
# been verified. A provider URL that contains an API key is fine here: it never reaches the browser.
SOLANA_RPC_URL=
# Price endpoint in Jupiter Price API v3 form. Empty: https://lite-api.jup.ag/price/v3
WALLET_PRICE_URL=
# Development only: 1 installs a mock Phantom wallet (no real wallet needed). Use with
# `npm run mock:solana` and SOLANA_RPC_URL=http://127.0.0.1:8899 WALLET_PRICE_URL=http://127.0.0.1:8899/price
NEXT_PUBLIC_MOCK_PHANTOM=
